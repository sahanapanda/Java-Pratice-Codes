class Solution {
    public int minimumDeletions(int[] nums) {
        int n = nums.length;
        int minIdx = 0;
        int maxIdx = 0;

        for (int i = 0; i < n; i++) {
            if (nums[i] < nums[minIdx]) {
                minIdx = i;
            }
            if (nums[i] > nums[maxIdx]) {
                maxIdx = i;
            }
        }

        int low = Math.min(minIdx, maxIdx);
        int high = Math.max(minIdx, maxIdx);

        // Scenario 1: Remove both from the front
        int removeFromFront = high + 1;

        // Scenario 2: Remove both from the back
        int removeFromBack = n - low;

        // Scenario 3: Remove one from the front and one from the back
        int removeFromBoth = (low + 1) + (n - high);

        return Math.min(removeFromFront, Math.min(removeFromBack, removeFromBoth));
    }
}
