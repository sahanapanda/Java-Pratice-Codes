class Solution {
    private int matchingNodeCount = 0;

    public int averageOfSubtree(TreeNode root) {
        postOrder(root);
        return matchingNodeCount;
    }

    /**
     * Helper function performing post-order traversal (DFS).
     * Returns an array where:
     * index 0 = sum of node values in current subtree
     * index 1 = total count of nodes in current subtree
     */
    private int[] postOrder(TreeNode node) {
        if (node == null) {
            return new int[]{0, 0};
        }

        // Traverse left and right subtrees first
        int[] left = postOrder(node.left);
        int[] right = postOrder(node.right);

        // Calculate sum and node count for the current subtree
        int currentSum = left[0] + right[0] + node.val;
        int currentCount = left[1] + right[1] + 1;

        // Check if the node value equals the average (rounded down)
        if (node.val == currentSum / currentCount) {
            matchingNodeCount++;
        }

        return new int[]{currentSum, currentCount};
    }
}
