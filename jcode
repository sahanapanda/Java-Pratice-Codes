class Solution {
    public int minOperations(String s) {
        char[] cs = s.toCharArray();
        int n = cs.length;
        
        char mn = cs[0], mx = cs[0];
        boolean sorted = true;
        
        for (int i = 1; i < n; i++) {
            if (cs[i] < mn) mn = cs[i];
            if (cs[i] > mx) mx = cs[i];
            if (sorted && cs[i] < cs[i - 1]) {
                sorted = false;
            }
        }
        
        // Case 1: Already sorted
        if (sorted) {
            return 0;
        }
        
        // Case 2: Length is 2 and not sorted
        if (n == 2) {
            return -1;
        }
        
        // Case 3: Smallest char is at index 0 or largest char is at index n - 1
        if (cs[0] == mn || cs[n - 1] == mx) {
            return 1;
        }
        
        // Case 4: Smallest or largest char is anywhere in the middle (indices 1 to n-2)
        for (int i = 1; i < n - 1; i++) {
            if (cs[i] == mn || cs[i] == mx) {
                return 2;
            }
        }
        
        // Case 5: Otherwise
        return 3;
    }
}
